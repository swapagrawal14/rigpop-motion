{
  "name": "rigpop-motion",
  "version": "0.2.0",
  "description": "Cartoon animation in code: layered vector character rigs with IK, an always-alive motion system, and readable stage-direction scripts rendered to vertical reels with voices, captions and cue-locked sound.",
  "type": "module",
  "bin": {
    "rigpop-motion": "bin/rigpop-motion.js"
  },
  "scripts": {
    "render": "node src/v2/cli.mjs render",
    "still": "node src/v2/cli.mjs still",
    "midnight": "node src/v2/cli.mjs render scripts/midnight-maggi.md -o out/midnight-maggi.mp4 --crf 25",
    "poses": "node src/extract-poses.mjs",
    "walk": "node src/flipbook-walk.mjs",
    "cutout": "node src/cutout-walk.mjs",
    "assets": "node src/chai-assets.mjs",
    "short": "node src/chai-short.mjs",
    "maggi": "node src/maggi-short.mjs",
    "maggi:assets": "node src/maggi-assets.mjs",
    "maggi:prep": "node src/prep-maggi.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "files": [
    "bin",
    "src",
    "scripts",
    "assets/fonts",
    "assets/maggi/*.wav",
    "assets/maggi/bed.m4a",
    "assets/chai/*.wav"
  ]
}
